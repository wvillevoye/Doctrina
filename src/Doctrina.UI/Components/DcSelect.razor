@typeparam TValue
@inherits DcFieldBase<TValue>

@* Keuzelijst met label en foutmelding. De opties zijn gewone <option>-elementen als inhoud. *@
<div class="dc-field">
  <label for="@InputId" class="form-label dc-field__label">
    @Label
    @if (Required)
    {
      <span class="dc-field__required">(verplicht)</span>
    }
  </label>
  <InputSelect TValue="TValue" id="@InputId" class="@(IsInvalid ? "form-select is-invalid" : "form-select")"
               Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
               @attributes="InputAttributes">@ChildContent</InputSelect>
  @if (Hint is not null)
  {
    <div id="@HintId" class="dc-field__hint">@Hint</div>
  }
  <DcFieldError Id="@ErrorId" Field="@Field" />
</div>

@code {
    /// <summary>De opties, als <c>&lt;option value="…"&gt;…&lt;/option&gt;</c>.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }
}
