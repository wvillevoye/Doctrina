@inject Doctrina.Infrastructure.Modules.ModuleCatalog Modules

<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="Modules.ComponentAssemblies">
  <Found Context="routeData">
    <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
      <NotAuthorized>
        <NotAuthorized />
      </NotAuthorized>
    </AuthorizeRouteView>
    <FocusOnNavigate RouteData="routeData" Selector="h1" />
  </Found>
</Router>
