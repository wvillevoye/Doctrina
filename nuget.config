<?xml version="1.0" encoding="utf-8"?>
<!-- Alleen nuget.org voor deze repo; machine-brede bronnen (GitLab/GitHub) tellen hier niet mee.
     Package source mapping voorkomt dat een package uit een onverwachte bron komt. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
