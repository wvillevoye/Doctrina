@using Doctrina.Core.Modules
@using Doctrina.Infrastructure.Modules
@inject ModuleCatalog Modules

@* Hoofdmenu: vaste items van de host plus de items van ingeschakelde modules, gefilterd op permissie
   (spec module-system "Modules leveren navigatie"). *@
<nav aria-label="Hoofdmenu">
  <ul>
    <li><NavLink href="/" Match="NavLinkMatch.All">Start</NavLink></li>
    @foreach (var item in VisibleItems)
    {
      <li><NavLink href="@item.Href">@item.Title</NavLink></li>
    }
    @if (_user.Identity?.IsAuthenticated == true)
    {
      <li><NavLink href="/profiel">Mijn profiel</NavLink></li>
    }
  </ul>
</nav>

@code {
    private ClaimsPrincipal _user = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IEnumerable<NavItem> VisibleItems =>
        Modules.Navigation.Where(item => item.RequiredPermission is null
            || _user.HasClaim(DoctrinaClaimTypes.Permission, item.RequiredPermission));

    protected override async Task OnParametersSetAsync()
    {
        _user = AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;
    }
}
