@* Tekstlink met de huisstijl (onderstreept, offset). Opent een externe link in een nieuw venster en zegt dat. *@
<a href="@Href" class="dc-link" target="@(External ? "_blank" : null)" rel="@(External ? "noopener noreferrer" : null)"
   @attributes="AdditionalAttributes">@if (Icon is not null) { <DcIcon Name="@Icon" /> }@ChildContent@if (External) { <DcIcon Name="external-link" /><span class="visually-hidden"> (opens in a new window)</span> }</a>

@code {
    [Parameter, EditorRequired]
    public string Href { get; set; } = string.Empty;

    /// <summary>Linktekst; verplicht, want die is de toegankelijke naam.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Link naar een andere site: opent in een nieuw venster.</summary>
    [Parameter]
    public bool External { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (ChildContent is null)
        {
            throw new InvalidOperationException("DcLink heeft geen linktekst; die is nodig als toegankelijke naam.");
        }
    }
}
