@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@* Shows an expected error from a Result (spec ui-components "Fouten uit een Result worden eenduidig getoond"):
   the translated title for the error code (IErrorTitles, design D8) in an alert that is announced immediately. *@
@if (Error is not null)
{
  <DcAlert Severity="DcSeverity.Danger" Title="@Title" data-testid="result-error" data-error-code="@Error.Code">
    @if (_messages.Count > 0)
    {
      <ul class="dc-result__messages">
        @foreach (var message in _messages)
        {
          <li>@message</li>
        }
      </ul>
    }
  </DcAlert>
}

@code {
    private List<string> _messages = [];

    /// <summary>The error; without an error the component shows nothing.</summary>
    [Parameter]
    public Error? Error { get; set; }

    /// <summary>
    /// Messages below the title. By default all messages per field from <see cref="Error.Details"/>; <see cref="DcForm"/>
    /// passes only the messages that do not belong to a field.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string>? Messages { get; set; }

    private string Title => Error is null
        ? string.Empty
        : Services.GetService<IErrorTitles>()?.For(Error.Code, Error.Message) ?? Error.Message;

    protected override void OnParametersSet() =>
        _messages = Messages is not null
            ? [.. Messages]
            : [.. Error?.Details?.SelectMany(d => d.Value) ?? []];
}
