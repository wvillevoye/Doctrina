@page "/geen-toegang"

<DcPageHeader Title="Geen toegang" />

<DcAlert Severity="DcSeverity.Warning">
  <p>Je bent ingelogd, maar je hebt geen rechten voor deze pagina.</p>
</DcAlert>
<DcButton Href="/" Icon="arrow-left">Terug naar de startpagina</DcButton>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
        }
    }
}
