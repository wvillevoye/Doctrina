<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Exit code 8 = "zero tests ran": test projects that have no tests yet (tests follow per task group) don't fail the run. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <!-- At most 3 tests at a time per test project, so at most 3 LocalDB test databases per project (each test has its own database). -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Doctrina.TestKit' and '$(ArchitectureFixture)' != 'true'">
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
