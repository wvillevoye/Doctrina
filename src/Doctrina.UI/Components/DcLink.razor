@* Text link in the house style (underlined, with offset). Opens an external link in a new window and says so. *@
<a href="@Href" class="dc-link" target="@(External ? "_blank" : null)" rel="@(External ? "noopener noreferrer" : null)"
   @attributes="AdditionalAttributes">@if (Icon is not null) { <DcIcon Name="@Icon" /> }@ChildContent@if (External) { <DcIcon Name="external-link" /><span class="visually-hidden"> (opens in a new window)</span> }</a>

@code {
    [Parameter, EditorRequired]
    public string Href { get; set; } = string.Empty;

    /// <summary>Link text; required, because it is the accessible name.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Link to another site: opens in a new window.</summary>
    [Parameter]
    public bool External { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (ChildContent is null)
        {
            throw new InvalidOperationException("DcLink heeft geen linktekst; die is nodig als toegankelijke naam.");
        }
    }
}
