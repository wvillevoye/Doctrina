{
  "Modules": {
    "Enabled": []
  },
  "Lti": {
    // The stable address of this platform (the "iss" of launches); empty = the address the request came in on.
    "Issuer": "",
    "Keys": {
      "RetireAfterDays": 7
    }
  },
  "Content": {
    "Files": {
      "Path": "App_Data/content",
      "MaxSizeMb": 100
    }
  },
  "Authorization": {
    "RolePermissions": {
      "admin": [ "*" ],
      "employee": [],
      "student": []
    }
  },
  "Authentication": {
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "RequireHttpsMetadata": true,
      "Scopes": [ "openid", "profile", "email" ],
      "IdpHint": "",
      "SessionLifetime": "08:00:00"
    },
    "Api": {
      "Audience": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
