@page "/error"
@using System.Diagnostics

@* Foutpagina voor pagina's (niet voor /api: die krijgen ProblemDetails). Toont geen exceptiondetails, alleen een
   trace-id waarmee beheer de fout in de logs terugvindt. *@
<DcPageHeader Title="Something went wrong" />

<DcAlert Severity="DcSeverity.Danger">
  <p>An unexpected error occurred. Please try again later.</p>
  @if (!string.IsNullOrEmpty(_traceId))
  {
    <p>If you report this, mention this code: <code data-testid="trace-id">@_traceId</code></p>
  }
</DcAlert>
<DcButton Href="/" Icon="arrow-left">Back to the home page</DcButton>

@code {
    private string? _traceId;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized() =>
        _traceId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
