@* Dialoog voor de stijlgids (en de handmatige controle van focus en Escape, taak 8.2 van add-design-system). *@
<DcButton Variant="DcButtonVariant.Danger" Icon="trash-2" OnClick="() => _modal.ShowAsync()">Cursus verwijderen…</DcButton>
@if (_closed > 0)
{
  <p class="dc-styleguide__note" role="status">Dialoog @(_closed)× gesloten.</p>
}

<DcModal @ref="_modal" Title="Cursus verwijderen?" OnClose="() => _closed++">
  <ChildContent>
    <p>De cursus en alle inschrijvingen worden verwijderd. Dit kun je niet ongedaan maken.</p>
  </ChildContent>
  <Footer>
    <DcButton OnClick="() => _modal.CloseAsync()">Annuleren</DcButton>
    <DcButton Variant="DcButtonVariant.Danger" OnClick="() => _modal.CloseAsync()">Verwijderen</DcButton>
  </Footer>
</DcModal>

@code {
    private DcModal _modal = default!;
    private int _closed;
}
