{
  // Omgeving "Test" = de geautomatiseerde tests (design D13). Geen echte secrets: de provider is nagebootst
  // (Doctrina.TestKit/StubOidcProvider) en LocalDB gebruikt Windows-authenticatie.
  "Authentication": {
    "Oidc": {
      "Authority": "https://idp.test/realms/doctrina",
      "ClientId": "doctrina-web",
      "ClientSecret": "test-secret",
      "RequireHttpsMetadata": true,
      "IdpHint": ""
    },
    "Api": {
      "Audience": "doctrina-api"
    }
  },
  "ConnectionStrings": {
    // De databasefixture (taak 5.1) vervangt de databasenaam door een unieke naam per testrun.
    "Doctrina": "Server=(localdb)\\MSSQLLocalDB;Database=Doctrina_Test;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
