@inject NavigationManager NavigationManager

@* Main menu as a vertical list (spec app-shell "Het hoofdmenu werkt op elk schermformaat", design D1/D2 of
   add-sidebar-navigation). DcAppShell places it in the sidebar; the Menu button and the popover are part of the shell.
   Colours come from the --dc-sidebar-* tokens. *@
<nav aria-label="@Label" class="dc-nav">
  <ul class="dc-nav__list">
    @foreach (var item in Items)
    {
      <li>
        <a href="@item.Href" class="dc-nav__link" aria-current="@(IsCurrent(item) ? "page" : null)">
          @if (item.Icon is not null)
          {
            <DcIcon Name="@item.Icon" />
          }
          <span>@item.Title</span>
        </a>
      </li>
    }
  </ul>
</nav>

@code {
    /// <summary>Name of the navigation landmark.</summary>
    [Parameter]
    public string Label { get; set; } = "Main menu";

    [Parameter, EditorRequired]
    public IReadOnlyList<DcNavItem> Items { get; set; } = [];

    private bool IsCurrent(DcNavItem item)
    {
        var path = Normalize(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).AbsolutePath);
        var href = Normalize(item.Href);

        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase)
            || (!item.MatchAll && href != "/" && path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase));
    }

    private static string Normalize(string path)
    {
        var trimmed = path.TrimEnd('/');
        return trimmed.Length == 0 ? "/" : trimmed;
    }
}
