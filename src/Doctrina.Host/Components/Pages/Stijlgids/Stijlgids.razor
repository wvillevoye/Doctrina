@page "/stijlgids"
@rendermode InteractiveServer
@using Doctrina.Core.Results
@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
@inject NavigationManager Navigation

@* Stijlgids (spec ui-components "De stijlgids toont elk component", design D11): elk Dc*-component in zijn varianten,
   licht en donker naast elkaar. Alleen in Development of met Ui:StyleGuide:Enabled; anders 404. Interactief, zodat
   de dialoog en de formulieren werken. *@
@if (_enabled)
{
  <DcPageHeader Title="Stijlgids">
    <Description>Alle componenten van Doctrina.UI, in het lichte en het donkere thema. Regels en voorbeelden staan in docs/ontwikkelen/vormgeving.md.</Description>
  </DcPageHeader>

  <nav aria-label="Componenten" class="dc-styleguide__toc">
    <ul>
      @foreach (var component in Components)
      {
        <li><a href="@($"stijlgids#{StijlgidsSectie.SectionId(component)}")">@component.Name.Split('`')[0]</a></li>
      }
    </ul>
  </nav>

  <StijlgidsSectie Component="typeof(DcButton)" Description="Knop voor acties; met Href een link in knopvorm. Altijd tekst of een Label.">
    <Sample>
      <div class="dc-styleguide__row">
        <DcButton Variant="DcButtonVariant.Primary" Icon="plus">Cursus toevoegen</DcButton>
        <DcButton>Bewerken</DcButton>
        <DcButton Variant="DcButtonVariant.Ghost">Annuleren</DcButton>
        <DcButton Variant="DcButtonVariant.Danger" Icon="trash-2">Verwijderen</DcButton>
        <DcButton Variant="DcButtonVariant.Ghost" Icon="pencil" Label="Bewerken" />
        <DcButton Variant="DcButtonVariant.Primary" Busy>Opslaan</DcButton>
        <DcButton Disabled>Uitgeschakeld</DcButton>
        <DcButton Href="/stijlgids" Icon="arrow-right">Link als knop</DcButton>
      </div>
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcLink)" Description="Tekstlink, onderstreept met offset; een externe link opent in een nieuw venster en zegt dat.">
    <Sample>
      <p>Lees de <DcLink Href="/stijlgids">regels voor modules</DcLink> of ga naar <DcLink Href="https://www.surf.nl/" External>SURF</DcLink>.</p>
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcIcon)" Description="Lucide-iconen als inline SVG; decoratief, tenzij er een Label is.">
    <Sample>
      <div class="dc-styleguide__row dc-styleguide__icons">
        @foreach (var name in Doctrina.UI.Icons.DcIconSet.Names)
        {
          <span title="@name"><DcIcon Name="@name" Label="@name" /></span>
        }
      </div>
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcPageHeader)" Description="Kop van een pagina: de enige h1, beschrijving en acties; zet de titel van het venster. (Hier als h1 binnen een voorbeeld.)">
    <Sample>
      <div class="dc-styleguide__frame" role="presentation">
        <p class="dc-styleguide__note">De kop van deze pagina ("Stijlgids") is een DcPageHeader; hieronder de opbouw zonder tweede h1.</p>
        <DcCard Title="Cursussen" HeadingLevel="3">
          <p>Beschrijving onder de kop.</p>
          <div class="dc-styleguide__row"><DcButton Variant="DcButtonVariant.Primary" Icon="plus">Nieuwe cursus</DcButton></div>
        </DcCard>
      </div>
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcCard)" Description="Vlak met dunne rand; met titel een benoemde sectie, optioneel met een voet voor acties.">
    <Sample>
      <DcCard Title="Celbiologie (BIO101)">
        <ChildContent><p>Inleiding in de bouw en werking van cellen. 6 EC, periode 1.</p></ChildContent>
        <Footer><DcButton Variant="DcButtonVariant.Primary">Inschrijven</DcButton><DcButton Variant="DcButtonVariant.Ghost">Details</DcButton></Footer>
      </DcCard>
      <DcCard><p>Card zonder titel.</p></DcCard>
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcAlert)" Description="Melding; info en succes worden beleefd aangekondigd, waarschuwing en fout direct.">
    <Sample>
      <DcAlert Severity="DcSeverity.Info"><p>De import draait op de achtergrond.</p></DcAlert>
      <DcAlert Severity="DcSeverity.Success" Title="Opgeslagen"><p>De cursus is bijgewerkt.</p></DcAlert>
      <DcAlert Severity="DcSeverity.Warning"><p>Deze cursus heeft nog geen docent.</p></DcAlert>
      <DcAlert Severity="DcSeverity.Danger" Title="Niet gelukt"><p>De koppeling met het roosterpakket reageert niet.</p></DcAlert>
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcBadge)" Description="Label voor een status of categorie; de betekenis staat in de tekst.">
    <Sample>
      <div class="dc-styleguide__row">
        <DcBadge>Concept</DcBadge>
        <DcBadge Variant="DcBadgeVariant.Accent">Nieuw</DcBadge>
        <DcBadge Variant="DcBadgeVariant.Success">Actief</DcBadge>
        <DcBadge Variant="DcBadgeVariant.Warning">Bijna vol</DcBadge>
        <DcBadge Variant="DcBadgeVariant.Danger">Geblokkeerd</DcBadge>
        <DcBadge Variant="DcBadgeVariant.Info">Extern</DcBadge>
      </div>
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcTable<>)" Description="Semantische tabel met bijschrift en kolomkoppen; zonder rijen een melding.">
    <Sample>
      <DcTable TItem="Cursus" Caption="Cursussen" Columns="CourseColumns" Items="Courses" EmptyText="Nog geen cursussen." />
      <DcTable TItem="Cursus" Caption="Gearchiveerde cursussen" Columns="CourseColumns" Items="NoCourses" EmptyText="Nog geen gearchiveerde cursussen." />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcForm)" Description="Formulier rond EditForm met DataAnnotations; fouten uit een Result komen bij de velden.">
    <Sample>
      <FormulierVoorbeeld Variant="@context" />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcTextField)" Description="Tekstveld met zichtbaar label, verplicht-markering en toelichting. Zie ook DcForm.">
    <Sample>
      <FormulierVoorbeeld Variant="@($"tekst-{context}")" />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcSelect<>)" Description="Keuzelijst met label; opties als gewone option-elementen. Zie het formulier bij DcForm.">
    <Sample>
      <FormulierVoorbeeld Variant="@($"keuze-{context}")" />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcCheckbox)" Description="Selectievakje met klikbaar label erachter. Zie het formulier bij DcForm.">
    <Sample>
      <FormulierVoorbeeld Variant="@($"vinkje-{context}")" />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcFieldError)" Description="Foutmelding bij een veld, gekoppeld met aria-describedby; hier via een validatiefout uit een Result.">
    <Sample>
      <FormulierVoorbeeld Variant="@($"fout-{context}")" WithErrors />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcResult)" Description="Verwachte fout uit een Result: de vertaalde titel bij de foutcode.">
    <Sample>
      <DcResult Error="SampleError" />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcModal)" Description="Dialoog met de native dialog: focus vast, Escape en sluitknop, focus terug naar de knop.">
    <Sample>
      <ModalVoorbeeld />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcNavMenu)" Description="Hoofdmenu; op smalle schermen achter de knop Menu (Popover API), op brede schermen altijd zichtbaar.">
    <Sample>
      <DcNavMenu Id="@($"voorbeeldmenu-{context}")" Label="@($"Voorbeeldmenu {context}")" Items="NavItems" />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcAccountMenu)" Description="Accountgedeelte: Inloggen voor anonieme bezoekers, anders de naam met een menu.">
    <Sample>
      <div class="dc-styleguide__row">
        <DcAccountMenu SignInHref="/inloggen?returnUrl=%2Fstijlgids" SignOutAction="/uitloggen" />
        <DcAccountMenu UserName="Sanne Student" MenuId="@($"voorbeeldaccount-{context}")" SignInHref="/inloggen" SignOutAction="/uitloggen" />
      </div>
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcThemeSwitcher)" Description="Themakeuze licht, donker of systeem; een gewoon formulier, de actieve keuze heeft aria-pressed.">
    <Sample>
      <DcThemeSwitcher Current="DcTheme.Dark" ReturnUrl="/stijlgids" />
    </Sample>
  </StijlgidsSectie>

  <StijlgidsSectie Component="typeof(DcAppShell)" Description="De layout van elke pagina: skiplink, header met merk, hoofdmenu, themakeuze en account, en de hoofdinhoud.">
    <Sample>
      <p class="dc-styleguide__note">Deze pagina zelf staat in de DcAppShell: kijk naar de header hierboven, en verklein het venster voor de menuknop.</p>
    </Sample>
  </StijlgidsSectie>
}

@code {
    private static readonly Type[] Components =
    [
        typeof(DcButton), typeof(DcLink), typeof(DcIcon), typeof(DcPageHeader), typeof(DcCard), typeof(DcAlert),
        typeof(DcBadge), typeof(DcTable<>), typeof(DcForm), typeof(DcTextField), typeof(DcSelect<>), typeof(DcCheckbox),
        typeof(DcFieldError), typeof(DcResult), typeof(DcModal), typeof(DcNavMenu), typeof(DcAccountMenu),
        typeof(DcThemeSwitcher), typeof(DcAppShell),
    ];

    private static readonly DcTableColumn<Cursus>[] CourseColumns =
    [
        new("Code", c => c.Code),
        new("Naam", c => c.Name),
        new("EC", c => c.Credits),
        new("Status", Template: c => @<DcBadge Variant="@(c.Active ? DcBadgeVariant.Success : DcBadgeVariant.Neutral)">@(c.Active ? "Actief" : "Concept")</DcBadge>),
    ];

    private static readonly Cursus[] Courses =
    [
        new("BIO101", "Celbiologie", 6, true),
        new("WIS201", "Analyse 2", 5, true),
        new("FIL110", "Inleiding wijsbegeerte", 5, false),
    ];

    private static readonly Cursus[] NoCourses = [];

    private static readonly DcNavItem[] NavItems = [new("Start", "/", MatchAll: true), new("Stijlgids", "/stijlgids"), new("Mijn profiel", "/profiel")];

    private static readonly Error SampleError = Error.Forbidden("Auth.Forbidden", "Geen toegang tot deze cursus.");

    private bool _enabled;

    protected override void OnInitialized()
    {
        _enabled = Environment.IsDevelopment() || Configuration.GetValue<bool>("Ui:StyleGuide:Enabled");
        if (!_enabled)
        {
            Navigation.NotFound();
        }
    }

    private sealed record Cursus(string Code, string Name, int Credits, bool Active);
}
