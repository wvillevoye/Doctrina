<Project>
  <!-- Central Package Management: alle versies op één plek. Microsoft-packages blijven op 10.0.x (.NET 10 LTS). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="ASP.NET Core / EF Core (10.0.x)">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
  </ItemGroup>
  <ItemGroup Label="Overig (MIT / Apache-2.0)">
    <PackageVersion Include="Scalar.AspNetCore" Version="2.20.0" />
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.108.1" />
    <!-- Markdown for pages (BSD-2-Clause; change add-content). -->
    <PackageVersion Include="Markdig" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup Label="Achtergrondtaken (LGPL-3.0, OSI; change add-bulk-import)">
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <!-- Transitief via Hangfire (die 11.0.1 vraagt, met een bekend lek); MIT. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
