<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Blazor Web App (Interactive Server): start-up, routing, auth, module loading. -->
  <PropertyGroup>
    <RootNamespace>Doctrina.Host</RootNamespace>
    <UserSecretsId>doctrina-host</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test settings and secrets are never included when publishing (design D13). -->
    <Content Update="appsettings.Test.json;appsettings.Secrets.json;appsettings.Secrets.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doctrina.Core\Doctrina.Core.csproj" />
    <ProjectReference Include="..\Doctrina.Infrastructure\Doctrina.Infrastructure.csproj" />
    <ProjectReference Include="..\Doctrina.UI\Doctrina.UI.csproj" />
    <ProjectReference Include="..\Modules\Academic\Doctrina.Modules.Academic\Doctrina.Modules.Academic.csproj" />
    <ProjectReference Include="..\Modules\Content\Doctrina.Modules.Content\Doctrina.Modules.Content.csproj" />
    <ProjectReference Include="..\Modules\Lti\Doctrina.Modules.Lti\Doctrina.Modules.Lti.csproj" />
    <ProjectReference Include="..\Modules\Groups\Doctrina.Modules.Groups\Doctrina.Modules.Groups.csproj" />
    <ProjectReference Include="..\Modules\Interop\Doctrina.Modules.Interop.OOAPI\Doctrina.Modules.Interop.OOAPI.csproj" />
  </ItemGroup>
</Project>
