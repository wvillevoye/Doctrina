@* Surface with a thin border and a generous radius (voorstel §7.0). With a title it is a named section. *@
@if (Title is not null)
{
  <section class="card dc-card" aria-labelledby="@_titleId" @attributes="AdditionalAttributes">
    <div class="card-body">
      @switch (HeadingLevel)
      {
        case 3:
          <h3 id="@_titleId" class="dc-card__title">@Title</h3>
          break;
        case 4:
          <h4 id="@_titleId" class="dc-card__title">@Title</h4>
          break;
        default:
          <h2 id="@_titleId" class="dc-card__title">@Title</h2>
          break;
      }
      @ChildContent
    </div>
    @if (Footer is not null)
    {
      <div class="dc-card__footer">@Footer</div>
    }
  </section>
}
else
{
  <div class="card dc-card" @attributes="AdditionalAttributes">
    <div class="card-body">@ChildContent</div>
    @if (Footer is not null)
    {
      <div class="dc-card__footer">@Footer</div>
    }
  </div>
}

@code {
    private readonly string _titleId = DcIds.New("card");

    /// <summary>Title; makes the card a section named after that title.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Heading level of the title: 2 (default, below the h1 of <see cref="DcPageHeader"/>), 3 or 4.</summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Bottom edge with actions.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
