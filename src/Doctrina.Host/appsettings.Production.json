{
  // Productie, zonder secrets (design D13). Authority, ClientId, ClientSecret, Audience en de connection string komen uit
  // appsettings.Secrets.json op de server of uit omgevingsvariabelen (bv. Authentication__Oidc__ClientSecret).
  "Authentication": {
    "Oidc": {
      "RequireHttpsMetadata": true,
      "IdpHint": ""
    },
    "Api": {
      "RequireHttpsMetadata": true
    }
  },
  "Api": {
    "Documentation": {
      "Enabled": false
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
