{
  "Modules": {
    "Enabled": [ "Academic" ]
  },
  "Authorization": {
    "RolePermissions": {
      "employee": [ "Academic.MyCourses" ],
      "student": [ "Academic.MyCourses" ]
    }
  },
  "Authentication": {
    "Oidc": {
      "Authority": "http://localhost:8080/realms/doctrina",
      "ClientId": "doctrina-web",
      "RequireHttpsMetadata": false,
      "IdpHint": ""
    },
    "Api": {
      "Audience": "doctrina-api"
    }
  },
  "ConnectionStrings": {
    "Doctrina": "Server=(localdb)\\MSSQLLocalDB;Database=Doctrina;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  }
}
