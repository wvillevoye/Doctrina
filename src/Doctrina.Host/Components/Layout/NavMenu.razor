@using Doctrina.Core.Modules
@using Doctrina.Infrastructure.Modules
@inject ModuleCatalog Modules

@* Hoofdmenu: vaste items van de host plus de items van ingeschakelde modules, gefilterd op permissie
   (spec module-system "Modules leveren navigatie"). De weergave komt uit Doctrina.UI (DcNavMenu). *@
<DcNavMenu Items="@_items" />

@code {
    private IReadOnlyList<DcNavItem> _items = [];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;
        var items = new List<DcNavItem> { new("Home", "/", MatchAll: true) };
        items.AddRange(Modules.Navigation
            .Where(item => item.RequiredPermission is null || user.HasClaim(DoctrinaClaimTypes.Permission, item.RequiredPermission))
            .Select(item => new DcNavItem(item.Title, item.Href)));
        if (user.Identity?.IsAuthenticated == true)
        {
            items.Add(new DcNavItem("My profile", "/profile"));
        }

        _items = items;
    }
}
