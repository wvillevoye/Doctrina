@* Button or link in button form (design D7). Always an accessible name: text (ChildContent) or Label for an
   icon-only button (spec ui-components "Knoppen en links hebben altijd een toegankelijke naam"). *@
@if (Href is not null)
{
  <a href="@Href" class="@CssClass" @attributes="AdditionalAttributes">@Content</a>
}
else
{
  <button type="@Type" class="@CssClass" disabled="@(Disabled || Busy)" aria-busy="@(Busy ? "true" : null)"
          @onclick="HandleClick" @attributes="AdditionalAttributes">@Content</button>
}

@code {
    private RenderFragment Content => @<text>
        @if (Busy)
        {
          <DcIcon Name="loader-circle" Class="dc-icon--spin" />
        }
        else if (Icon is not null)
        {
          <DcIcon Name="@Icon" />
        }
        @if (ChildContent is not null)
        {
          <span>@ChildContent</span>
        }
        else
        {
          <span class="visually-hidden">@Label</span>
        }
        @if (Busy)
        {
          <span class="visually-hidden">(busy)</span>
        }
    </text>;

    /// <summary>Visible text of the button.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Accessible name for an icon-only button (not visible, but read aloud).</summary>
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public DcButtonVariant Variant { get; set; } = DcButtonVariant.Secondary;

    /// <summary>Lucide icon before the text.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Turns it into a link in button form (navigation instead of an action).</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary><c>button</c> (default), <c>submit</c> or <c>reset</c>.</summary>
    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The action is running: the button is disabled and announces "busy".</summary>
    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Variant switch
    {
        DcButtonVariant.Primary => "dc-button btn btn-primary",
        DcButtonVariant.Ghost => "dc-button btn btn-ghost",
        DcButtonVariant.Danger => "dc-button btn btn-danger",
        _ => "dc-button btn btn-secondary",
    } + (ChildContent is null ? " dc-button--icon" : string.Empty);

    // Even if an event still arrives (e.g. just before disabling): do not activate again.
    private Task HandleClick(MouseEventArgs args) => Busy || Disabled ? Task.CompletedTask : OnClick.InvokeAsync(args);

    protected override void OnParametersSet()
    {
        if (ChildContent is null && string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException(
                "DcButton heeft geen toegankelijke naam: geef tekst als inhoud of zet Label bij een knop met alleen een icoon.");
        }
    }
}
