@using Doctrina.UI.Components

@* Testopstelling voor DcModal (taak 5.4): een knop die een dialoog "Bevestigen" opent. *@
<DcButton OnClick="() => _modal.ShowAsync()" data-testid="open">Verwijderen…</DcButton>
<DcModal @ref="_modal" Title="Bevestigen" OnClose="() => Closed++">
  <p>Weet je het zeker?</p>
</DcModal>

@code {
    private DcModal _modal = default!;

    public int Closed { get; private set; }
}
