<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Component library: Dc* components, design tokens, SCSS (change add-design-system). -->
  <PropertyGroup>
    <RootNamespace>Doctrina.UI</RootNamespace>
    <!-- Compile only during the build; no watcher, no dart runtime in the output or reference to the package. -->
    <SassCompilerEnableWatcher>false</SassCompilerEnableWatcher>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- SCSS → CSS during dotnet build, without Node.js (design D1). -->
    <PackageReference Include="AspNetCore.SassCompiler" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lucide icons as embedded resources; DcIcon renders them inline (design D6). -->
    <EmbeddedResource Include="Icons\*.svg" LogicalName="Doctrina.UI.Icons.%(Filename).svg" />
    <Content Update="sasscompiler.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doctrina.Core\Doctrina.Core.csproj" />
  </ItemGroup>
</Project>
