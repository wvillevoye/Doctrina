@inherits DcFieldBase<bool>

@* Selectievakje met label erachter (klikbaar) en foutmelding. *@
<div class="dc-field">
  <div class="form-check">
    <InputCheckbox id="@InputId" class="@(IsInvalid ? "form-check-input is-invalid" : "form-check-input")"
                   Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                   @attributes="InputAttributes" />
    <label for="@InputId" class="form-check-label">
      @Label
      @if (Required)
      {
        <span class="dc-field__required">(verplicht)</span>
      }
    </label>
  </div>
  @if (Hint is not null)
  {
    <div id="@HintId" class="dc-field__hint">@Hint</div>
  }
  <DcFieldError Id="@ErrorId" Field="@Field" />
</div>
