@* Small label for a status or category. The meaning is in the text, not only in the colour. *@
<span class="dc-badge dc-badge--@Variant.ToString().ToLowerInvariant()" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [Parameter]
    public DcBadgeVariant Variant { get; set; } = DcBadgeVariant.Neutral;

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
