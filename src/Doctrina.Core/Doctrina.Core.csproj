<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared conventions and contracts, no domain logic and no infrastructure (see proposal §3.1).
       No NuGet packages; only the ASP.NET Core framework for the /api/v1 route group in IModule (design D2). -->
  <PropertyGroup>
    <RootNamespace>Doctrina.Core</RootNamespace>
    <!-- Public API: XML comments required (CS1591 enabled again). -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
