@page "/access-denied"

<DcPageHeader Title="Access denied" />

<DcAlert Severity="DcSeverity.Warning">
  <p>You are signed in, but you don't have permission to view this page.</p>
</DcAlert>
<DcButton Href="/" Icon="arrow-left">Back to the home page</DcButton>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
        }
    }
}
