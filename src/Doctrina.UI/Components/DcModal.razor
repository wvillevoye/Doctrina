@implements IAsyncDisposable
@inject IJSRuntime JS

@* Dialog with the native <dialog> (spec ui-components "Dialogen houden de focus vast", design D10). Open with
   ShowAsync() via @ref; close with the close button, Escape (by the browser) or CloseAsync(). Requires an interactive
   render mode. *@
<dialog @ref="_dialog" class="dc-modal" aria-labelledby="@_titleId" data-testid="modal">
  <div class="dc-modal__header">
    <h2 id="@_titleId" class="dc-modal__title">@Title</h2>
    <DcButton Variant="DcButtonVariant.Ghost" Icon="x" Label="Close" OnClick="CloseAsync" class="dc-modal__close" />
  </div>
  <div class="dc-modal__body">@ChildContent</div>
  @if (Footer is not null)
  {
    <div class="dc-modal__footer">@Footer</div>
  }
</dialog>

@code {
    private const string ModulePath = "./_content/Doctrina.UI/js/dc-modal.js";

    private readonly string _titleId = DcIds.New("dialoog");
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DcModal>? _self;

    /// <summary>Title; is also the accessible name of the dialog.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Buttons at the bottom, e.g. "Cancel" and "Delete".</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>After closing (button, Escape or <see cref="CloseAsync"/>); the focus has already been restored.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Is the dialog open?</summary>
    public bool IsOpen { get; private set; }

    /// <summary>Opens the dialog modally; the focus moves to the dialog and returns after closing.</summary>
    public async Task ShowAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("show", _dialog, _self);
        IsOpen = true;
    }

    /// <summary>Closes the dialog (same effect as Escape).</summary>
    public async Task CloseAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("close", _dialog);
        }
    }

    /// <summary>Called by the script after the <c>close</c> event of the dialog.</summary>
    [JSInvokable]
    public async Task OnClosed()
    {
        IsOpen = false;
        await OnClose.InvokeAsync();
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Title))
        {
            throw new InvalidOperationException("DcModal heeft een titel nodig; die is de naam van de dialoog.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Connection already gone: nothing to clean up in the browser.
            }
        }

        _self?.Dispose();
    }
}
