@page "/profile"
@attribute [Authorize]
@inject Doctrina.Infrastructure.Authorization.PermissionRegistry Registry

<DcPageHeader Title="My profile">
  <Description>Who you are according to the sign-in service, and what you are allowed to do in Doctrina.</Description>
</DcPageHeader>

@if (_user is not null)
{
  <DcCard Title="Details and permissions">
    <dl class="dc-details">
      <dt>Name</dt>
      <dd data-testid="name">@_user.Identity?.Name</dd>

      <dt>Person ID</dt>
      <dd data-testid="person-id">@(_user.FindFirst(DoctrinaClaimTypes.PersonId)?.Value ?? "–")</dd>

      <dt>Email</dt>
      <dd>@(_user.FindFirst(DoctrinaClaimTypes.Email)?.Value ?? "–")</dd>

      <dt>Signed in via (issuer)</dt>
      <dd data-testid="issuer">@_issuer</dd>

      <dt>User ID (sub)</dt>
      <dd>@(_user.FindFirst(DoctrinaClaimTypes.Subject)?.Value ?? "–")</dd>

      <dt>Roles</dt>
      <dd>
        @if (_roles.Count == 0)
        {
          <span>none</span>
        }
        else
        {
          <ul data-testid="roles">
            @foreach (var role in _roles)
            {
              <li>@role</li>
            }
          </ul>
        }
      </dd>

      <dt>Permissions per role</dt>
      <dd>
        <ul data-testid="role-permissions">
          @foreach (var role in _roles)
          {
            var granted = Registry.PermissionsFor([role]);
            <li>@role: @(granted.Count == 0 ? "none" : string.Join(", ", granted))</li>
          }
        </ul>
      </dd>

      <dt>Administrator</dt>
      <dd data-testid="is-admin">@(_user.IsInRole("admin") ? "yes" : "no")</dd>

      <dt>Permissions</dt>
      <dd>
        @if (_permissions.Count == 0)
        {
          <span data-testid="permissions">none</span>
        }
        else
        {
          <ul data-testid="permissions">
            @foreach (var permission in _permissions)
            {
              <li><code>@permission</code> – @(Registry.Find(permission)?.Description ?? "unknown")</li>
            }
          </ul>
        }
      </dd>
    </dl>
  </DcCard>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private ClaimsPrincipal? _user;
    private string? _issuer;
    private List<string> _roles = [];
    private List<string> _permissions = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        _user = (await AuthenticationState).User;
        _issuer = _user.FindFirst(DoctrinaClaimTypes.Subject)?.Issuer;
        _roles = [.. _user.FindAll(DoctrinaClaimTypes.Roles).Select(c => c.Value).Order(StringComparer.Ordinal)];
        _permissions = [.. _user.FindAll(DoctrinaClaimTypes.Permission).Select(c => c.Value).Distinct().Order(StringComparer.Ordinal)];
    }
}
