@inherits DcFieldBase<string>

@* Text field with a label, explanation and error message (spec ui-components, design D7). *@
<div class="dc-field">
  <label for="@InputId" class="form-label dc-field__label">
    @Label
    @if (Required)
    {
      <span class="dc-field__required">(required)</span>
    }
  </label>
  @if (Rows is { } rows)
  {
    <InputTextArea id="@InputId" rows="@rows" class="@(IsInvalid ? "form-control is-invalid" : "form-control")"
                   Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                   @attributes="InputAttributes" />
  }
  else
  {
    <InputText id="@InputId" type="@Type" class="@(IsInvalid ? "form-control is-invalid" : "form-control")"
               Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
               @attributes="InputAttributes" />
  }
  @if (Hint is not null)
  {
    <div id="@HintId" class="dc-field__hint">@Hint</div>
  }
  <DcFieldError Id="@ErrorId" Field="@Field" />
</div>

@code {
    /// <summary><c>text</c> (default), <c>email</c>, <c>password</c>, <c>tel</c>, <c>url</c>, <c>search</c>.</summary>
    [Parameter]
    public string Type { get; set; } = "text";

    /// <summary>Number of visible lines; makes the field a <c>textarea</c> (change add-content).</summary>
    [Parameter]
    public int? Rows { get; set; }
}
