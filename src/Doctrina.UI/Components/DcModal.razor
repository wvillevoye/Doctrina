@implements IAsyncDisposable
@inject IJSRuntime JS

@* Dialoog met de native <dialog> (spec ui-components "Dialogen houden de focus vast", design D10). Openen met
   ShowAsync() via @ref; sluiten met de sluitknop, Escape (door de browser) of CloseAsync(). Vereist een interactieve
   render-modus. *@
<dialog @ref="_dialog" class="dc-modal" aria-labelledby="@_titleId" data-testid="modal">
  <div class="dc-modal__header">
    <h2 id="@_titleId" class="dc-modal__title">@Title</h2>
    <DcButton Variant="DcButtonVariant.Ghost" Icon="x" Label="Sluiten" OnClick="CloseAsync" class="dc-modal__close" />
  </div>
  <div class="dc-modal__body">@ChildContent</div>
  @if (Footer is not null)
  {
    <div class="dc-modal__footer">@Footer</div>
  }
</dialog>

@code {
    private const string ModulePath = "./_content/Doctrina.UI/js/dc-modal.js";

    private readonly string _titleId = DcIds.New("dialoog");
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DcModal>? _self;

    /// <summary>Titel; is ook de toegankelijke naam van de dialoog.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Knoppen onderaan, bv. "Annuleren" en "Verwijderen".</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>Na sluiten (knop, Escape of <see cref="CloseAsync"/>); de focus is dan al teruggezet.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Is de dialoog open?</summary>
    public bool IsOpen { get; private set; }

    /// <summary>Opent de dialoog modaal; de focus gaat naar de dialoog en komt na sluiten terug.</summary>
    public async Task ShowAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("show", _dialog, _self);
        IsOpen = true;
    }

    /// <summary>Sluit de dialoog (zelfde gevolg als Escape).</summary>
    public async Task CloseAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("close", _dialog);
        }
    }

    /// <summary>Aangeroepen door het script na het <c>close</c>-event van de dialoog.</summary>
    [JSInvokable]
    public async Task OnClosed()
    {
        IsOpen = false;
        await OnClose.InvokeAsync();
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Title))
        {
            throw new InvalidOperationException("DcModal heeft een titel nodig; die is de naam van de dialoog.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Verbinding al weg: niets op te ruimen in de browser.
            }
        }

        _self?.Dispose();
    }
}
