@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* Bewust kale, semantische HTML: de vormgeving volgt met change add-design-system. *@
<a href="#inhoud" class="skip-link">Naar de inhoud</a>

<header>
  <a href="/" class="brand">Doctrina</a>
  <NavMenu />
  <div class="account">
    <AuthorizeView>
      <Authorized>
        <span data-testid="account-name">@context.User.Identity?.Name</span>
        <form method="post" action="@AuthenticationEndpoints.SignOutPath">
          <AntiforgeryToken />
          <input type="hidden" name="returnUrl" value="/" />
          <button type="submit">Uitloggen</button>
        </form>
      </Authorized>
      <NotAuthorized>
        <a href="@SignInHref">Inloggen</a>
      </NotAuthorized>
    </AuthorizeView>
  </div>
</header>

<main id="inhoud" tabindex="-1">
  @Body
</main>

<div id="blazor-error-ui" role="alert">
  Er ging iets mis op deze pagina. <a href="" class="reload">Opnieuw laden</a>
</div>

@code {
    private string SignInHref =>
        $"{AuthenticationEndpoints.SignInPath}?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";
}
