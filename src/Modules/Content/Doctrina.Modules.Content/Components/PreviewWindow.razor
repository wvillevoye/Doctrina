@using Doctrina.UI.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Preview of Markdown text in a window that can be dragged (mouse, touch, arrow keys) and resized (spec markdown-editor,
   design D6 of add-markdown-toolbar). Not modal: the form behind it stays usable. *@
<section class="md-preview" @ref="_window" data-testid="preview" aria-label="Preview">
  <header class="md-preview__bar">
    <div class="md-preview__handle" @ref="_handle" tabindex="0" title="Drag to move; arrow keys also work" data-testid="preview-handle">
      <DcIcon Name="grip" /> Preview
    </div>
    <DcButton Variant="DcButtonVariant.Ghost" Icon="x" Label="Close preview" OnClick="OnClose" data-testid="preview-close" />
  </header>
  <div class="md-preview__body"><MarkdownView Text="@Text" /></div>
</section>

@code {
    private ElementReference _window;
    private ElementReference _handle;
    private IJSObjectReference? _module;

    [Parameter] public string? Text { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Doctrina.Modules.Content/md-editor.js");
            await _module.InvokeVoidAsync("makeDraggable", _window, _handle);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
