@* Layout of every page (spec app-shell, design D9): skip link, header with brand, main menu, theme choice and
   account area, the sidebar with the main menu and the main content (design D1-D3 of add-sidebar-navigation).
   On narrow screens the sidebar is a popover behind the Menu button (native, works without scripts). *@
<a href="#content" class="dc-skip-link">Skip to content</a>

<header class="dc-shell__header">
  <div class="dc-shell__bar">
    <button type="button" class="dc-shell__toggle" popovertarget="dc-sidebar" data-testid="menu-toggle">
      <DcIcon Name="menu" />
      <span>Menu</span>
    </button>
    <a href="/" class="dc-shell__brand" data-testid="brand">
      @if (LogoPath is not null)
      {
        <img src="@LogoPath" alt="@LogoAlt" class="dc-shell__logo" />
      }
      else
      {
        <DcLogo Size="32" />
        <span class="dc-shell__wordmark">Doctrina</span>
      }
    </a>
    <div class="dc-shell__tools">
      <DcThemeSwitcher Current="Theme" ReturnUrl="@ReturnUrl" />
      <DcAccountMenu UserName="@UserName" SignInHref="@SignInHref" SignOutAction="@SignOutAction" ProfileHref="@ProfileHref" />
    </div>
  </div>
</header>

<div class="dc-shell__body">
  <aside id="dc-sidebar" popover class="dc-shell__sidebar">
    <div class="dc-shell__sidebar-inner">@Navigation</div>
  </aside>

  <main id="content" tabindex="-1" class="dc-shell__main">
    @ChildContent
  </main>
</div>

@code {
    /// <summary>The content of the page.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The main menu, usually a <see cref="DcNavMenu"/> with the items the host makes visible.</summary>
    [Parameter]
    public RenderFragment? Navigation { get; set; }

    /// <summary>Custom logo (white-label) instead of the wordmark; requires <see cref="LogoAlt"/>.</summary>
    [Parameter]
    public string? LogoPath { get; set; }

    [Parameter]
    public string? LogoAlt { get; set; }

    [Parameter]
    public DcTheme Theme { get; set; }

    /// <summary>The current page (local path), for the theme choice.</summary>
    [Parameter, EditorRequired]
    public string ReturnUrl { get; set; } = "/";

    /// <summary>Display name of the signed-in user; <see langword="null"/> for an anonymous visitor.</summary>
    [Parameter]
    public string? UserName { get; set; }

    [Parameter, EditorRequired]
    public string SignInHref { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string SignOutAction { get; set; } = string.Empty;

    [Parameter]
    public string ProfileHref { get; set; } = "/profile";
}
