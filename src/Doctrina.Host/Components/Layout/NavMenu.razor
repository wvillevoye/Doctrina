@using Doctrina.Core.Modules
@using Doctrina.Infrastructure.Modules
@inject ModuleCatalog Modules

@* Main menu: fixed items of the host plus the items of enabled modules, filtered by permission
   (spec module-system "Modules leveren navigatie"). The rendering comes from Doctrina.UI (DcNavMenu). *@
<DcNavMenu Items="@_items" />

@code {
    private IReadOnlyList<DcNavItem> _items = [];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthenticationState is null ? new ClaimsPrincipal() : (await AuthenticationState).User;
        var items = new List<DcNavItem> { new("Home", "/", MatchAll: true, Icon: "house") };
        items.AddRange(Modules.Navigation
            .Where(item => item.RequiredPermission is null || user.HasClaim(DoctrinaClaimTypes.Permission, item.RequiredPermission))
            .Select(item => new DcNavItem(item.Title, item.Href, Icon: item.Icon)));
        if (user.Identity?.IsAuthenticated == true)
        {
            items.Add(new DcNavItem("My profile", "/profile", Icon: "user"));
        }

        _items = items;
    }
}
