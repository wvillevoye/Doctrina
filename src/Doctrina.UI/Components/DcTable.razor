@typeparam TItem

@* Semantic table (spec ui-components "Tabellen zijn semantisch en hebben een lege toestand"): caption,
   column headers with scope="col" and a message instead of an empty table. A wide table scrolls within a
   named region that is reachable with the keyboard (WCAG 2.1.1, 1.4.10). *@
@if (Items.Count == 0)
{
  <p class="dc-table__empty" data-testid="table-empty">@EmptyText</p>
}
else
{
  <div class="dc-table" role="region" aria-labelledby="@_captionId" tabindex="0" @attributes="AdditionalAttributes">
    <table class="table dc-table__table">
      <caption id="@_captionId" class="@(HideCaption ? "visually-hidden" : "dc-table__caption")">@Caption</caption>
      <thead>
        <tr>
          @foreach (var column in Columns)
          {
            <th scope="col">@column.Title</th>
          }
        </tr>
      </thead>
      <tbody>
        @foreach (var item in Items)
        {
          <tr>
            @foreach (var column in Columns)
            {
              <td>@if (column.Template is not null) { @column.Template(item) } else { @column.Value?.Invoke(item) }</td>
            }
          </tr>
        }
      </tbody>
    </table>
  </div>
}

@code {
    private readonly string _captionId = DcIds.New("table");

    /// <summary>Caption; required, because it is the name of the table.</summary>
    [Parameter, EditorRequired]
    public string Caption { get; set; } = string.Empty;

    /// <summary>Caption for assistive technology only (when the heading above already says what the table is).</summary>
    [Parameter]
    public bool HideCaption { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<DcTableColumn<TItem>> Columns { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    /// <summary>Text when there are no rows, e.g. "No courses yet.".</summary>
    [Parameter, EditorRequired]
    public string EmptyText { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Caption))
        {
            throw new InvalidOperationException("DcTable heeft een bijschrift (Caption) nodig als naam van de tabel.");
        }
    }
}
