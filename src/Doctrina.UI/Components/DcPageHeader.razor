@* Heading of a page: the only h1, a description and actions. Also sets the title of the browser window in the form
   "<title> · Doctrina" (spec app-shell "Elke pagina heeft dezelfde toegankelijke opbouw"). *@
<PageTitle>@($"{DocumentTitle ?? Title} · Doctrina")</PageTitle>

<div class="dc-page-header">
  <div class="dc-page-header__text">
    <h1 class="dc-page-header__title">@Title</h1>
    @if (Description is not null)
    {
      <p class="dc-page-header__description">@Description</p>
    }
  </div>
  @if (Actions is not null)
  {
    <div class="dc-page-header__actions">@Actions</div>
  }
</div>

@code {
    /// <summary>Heading of the page (h1).</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Short explanation below the heading.</summary>
    [Parameter]
    public RenderFragment? Description { get; set; }

    /// <summary>Buttons for the page's main actions.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Different title for the browser window than the heading, e.g. "Home" for a welcome heading.</summary>
    [Parameter]
    public string? DocumentTitle { get; set; }
}
